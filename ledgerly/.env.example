# Telegram bot token from BotFather
BOT_TOKEN=replace-me

# One or more read-only tracking profiles. Do not commit real API keys.
NOVA_POSHTA_ACCOUNTS_JSON={"main":"replace-me"}

# Telegram supergroup and topic IDs
# EMPLOYEES = "До відправки".
# TRACKING = shared Nova Poshta/Ukrposhta tracking, 1C = bookkeeping cards.
TG_GROUP_ID=0
TG_SOURCE_THREAD_IDS=
TG_EMPLOYEES_THREAD_ID=0
TG_TRACKING_THREAD_ID=0
TG_1C_THREAD_ID=0
TG_RETURNS_THREAD_ID=0
TG_ALERTS_THREAD_ID=0

# Your Telegram ID. Keep 0 for the first start, send /whoami to the bot,
# then paste the returned number here and restart the bot.
TG_OWNER_USER_ID=0

# Owner-only financial commands. Generate with:
# python scripts/create_analytics_password.py
ANALYTICS_PASSWORD_HASH=replace-me
ANALYTICS_UNLOCK_MINUTES=15

# Optional future users. Leave empty while you work alone.
TG_ALLOWED_PRIVATE_USER_IDS=
TG_ADMIN_USER_IDS=
TG_EMPLOYEE_USER_IDS=

# Optional aliases used on tracking cards.
SPECIAL_CLIENTS_JSON={}

# PostgreSQL is the normal runtime database on Mac and Oracle Cloud.
# URL-encode special password characters such as @, :, /, # and %.
DATABASE_URL=postgresql://olx_bot:change-this-password@127.0.0.1:5432/olx_business
DATABASE_POOL_SIZE=4
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Only used as the source when importing an old SQLite database.
DATABASE_PATH=./data/tracking.sqlite3
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24
BACKUP_WORKER_ENABLED=true
TIMEZONE=Europe/Kyiv
LOG_LEVEL=INFO
TRACKER_BATCH_SIZE=20
TRACKER_IDLE_SECONDS=60
TRACKER_LEASE_SECONDS=300

