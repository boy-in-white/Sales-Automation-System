[Unit]
Description=Backup OLX business PostgreSQL database
After=postgresql.service

[Service]
Type=oneshot
User=olxbot
Group=olxbot
WorkingDirectory=/opt/olx-business-bot
EnvironmentFile=/etc/olx-business-bot.env
ExecStart=/opt/olx-business-bot/.venv/bin/python /opt/olx-business-bot/scripts/backup_once.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/olx-business-bot/backups

